# ---------------------------------------------------------------------------
# Yaqubu Radar - contact finder backend
# Copy this file to ".env" (in the repo root) and fill in your real keys.
# The server reads both "<repo>/.env" and "server/.env"; the root file wins.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Required: Apollo.io API key (Settings -> Integrations -> API in Apollo)
APOLLO_API_KEY=

# Required: Hunter.io API key (Dashboard -> API)
HUNTER_API_KEY=

# Optional: Google Gemini key. Used to read the brand's page text for hidden
# email addresses (before any Hunter credit is spent) and to pick the best
# Hunter candidate. Leave empty to skip both AI steps.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# HTTP port for the contact finder service
PORT=8787

# Comma separated list of browser origins allowed to call the API.
# Leave empty to allow any origin ("*"), which is fine while testing.
ALLOWED_ORIGINS=https://radar.yaqubu.com,http://localhost:8080

# Optional: protect the endpoint with the same Firebase login the frontend uses.
# Paste the Firebase web API key from index.html (FIREBASE_CONFIG.apiKey) and
# requests must then carry "Authorization: Bearer <firebase id token>".
FIREBASE_WEB_API_KEY=
REQUIRE_AUTH=false

# ------------------------- tuning (safe to leave as-is) --------------------

# Job titles to look for at the brand, best match first.
CONTACT_TITLES=Influencer Marketing,Partnerships,Creator Relations,Social Media Manager

# Hunter domain search rows to read when Apollo is missing/failing (Hunter then
# does the work alone). Lower saves credits, higher finds more people.
HUNTER_DOMAIN_SEARCH_LIMIT=10

# Let the browser send its own Hunter key in "x-hunter-api-key" (per request).
# Set to false to always use HUNTER_API_KEY above.
ALLOW_USER_HUNTER_KEY=true

# Gemini page-text email scan (the cheapest step: it runs before Hunter).
GEMINI_EMAIL_SCAN=true
# When the browser sends no page text, the service downloads the brand's pages
# itself for Gemini, within this budget.
SITE_TEXT_TIMEOUT_MS=6000

# Hunter verification results we accept, comma separated.
# Hunter reports "valid" in data.status and "deliverable" in data.result.
HUNTER_ACCEPT_STATUSES=valid,deliverable

# Accept catch-all ("accept_all") addresses? Risky, off by default.
ALLOW_ACCEPT_ALL=false

# Reject addresses that are not on the brand's own domain.
REQUIRE_BRAND_DOMAIN=true

# Person candidates to look at / enrich / verify per brand.
APOLLO_PER_PAGE=10
MAX_CANDIDATES=6
MAX_ENRICHED_CANDIDATES=2
MAX_EMAILS_TO_VERIFY=2

# Cache successful and failed lookups for this many seconds (credits saving).
CACHE_TTL_SECONDS=21600
# "Nothing found" answers are re-checked sooner than a verified contact.
CACHE_NEGATIVE_TTL_SECONDS=1800

# Outbound HTTP timeout / retries / parallel brand lookups.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
MAX_CONCURRENT_LOOKUPS=3
